{
  "name": "system1-decision-engines-video",
  "private": true,
  "version": "1.0.0",
  "description": "A narrated Motion Canvas explainer video summarising the System 1 decision engines tutorial.",
  "type": "module",
  "scripts": {
    "start": "vite",
    "narration": "node scripts/narration.mjs",
    "music": "node scripts/music.mjs",
    "render": "node scripts/render.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "node scripts/check-cues.mjs && tsc --noEmit -p tsconfig.json",
    "check:timing": "node scripts/check-timing.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-khmer": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/python": "^1.1.19",
    "@motion-canvas/2d": "^3.17.2",
    "@motion-canvas/core": "^3.17.2"
  },
  "devDependencies": {
    "@motion-canvas/ffmpeg": "^3.17.2",
    "@motion-canvas/ui": "^3.17.2",
    "@motion-canvas/vite-plugin": "^3.17.2",
    "@types/node": "^22.20.4",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
